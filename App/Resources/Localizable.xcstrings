{
  "sourceLanguage": "en",
  "strings": {
    "%lld mm": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld мм"
          }
        }
      }
    },
    "Accessibility": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Универсальный доступ"
          }
        }
      }
    },
    "Add App": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавить приложение"
          }
        }
      }
    },
    "All displays": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Со всех дисплеев"
          }
        }
      }
    },
    "Allow AppSwipe under Login Items in System Settings.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите AppSwipe в разделе «Объекты входа» Системных настроек."
          }
        }
      }
    },
    "App Switcher": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель приложений"
          }
        }
      }
    },
    "AppSwipe Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки AppSwipe"
          }
        }
      }
    },
    "Both Switchers are off, so swipes do nothing.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оба переключателя выключены, поэтому свайпы ничего не делают."
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрыть"
          }
        }
      }
    },
    "Couldn't change this: %@": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить: %@"
          }
        }
      }
    },
    "Diagnostics": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диагностика"
          }
        }
      }
    },
    "Display with the pointer": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С дисплея с указателем"
          }
        }
      }
    },
    "Excluded Apps": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Исключённые приложения"
          }
        }
      }
    },
    "Four fingers for apps, three for windows.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Четыре пальца для приложений, три для окон."
          }
        }
      }
    },
    "From one display, the App Switcher lists the app in front and the apps with a window there.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С одного дисплея переключатель показывает приложение на переднем плане и приложения, у которых там есть окно."
          }
        }
      }
    },
    "General": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Основные"
          }
        }
      }
    },
    "Granted": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешено"
          }
        }
      }
    },
    "Hide Finder when it has no windows": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скрывать Finder, когда у него нет окон"
          }
        }
      }
    },
    "How far the fingers travel to move the selection by one item.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько должны пройти пальцы, чтобы выделение сдвинулось на один элемент."
          }
        }
      }
    },
    "Launch at login": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запускать при входе в систему"
          }
        }
      }
    },
    "Live Switching": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Живое переключение"
          }
        }
      }
    },
    "Minimize": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свернуть"
          }
        }
      }
    },
    "No excluded apps": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет исключённых приложений"
          }
        }
      }
    },
    "No trackpad gestures conflict with AppSwipe.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты трекпада не мешают AppSwipe."
          }
        }
      }
    },
    "No windows": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет окон"
          }
        }
      }
    },
    "Open Accessibility Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки Универсального доступа"
          }
        }
      }
    },
    "Open Login Items Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть настройки объектов входа"
          }
        }
      }
    },
    "Open System Settings": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открыть Системные настройки"
          }
        }
      }
    },
    "Optional, for window previews. Takes effect after AppSwipe restarts: quit it with ⌘Q and open it again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательно, для превью окон. Действует после перезапуска AppSwipe: завершите его по ⌘Q и откройте снова."
          }
        }
      }
    },
    "Other App…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Другое приложение…"
          }
        }
      }
    },
    "Pause AppSwipe": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приостановить AppSwipe"
          }
        }
      }
    },
    "Permissions": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешения"
          }
        }
      }
    },
    "Quit AppSwipe": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершить AppSwipe"
          }
        }
      }
    },
    "Record touches": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывать касания"
          }
        }
      }
    },
    "Remove": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалить"
          }
        }
      }
    },
    "Required to read swipes and switch windows.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен, чтобы читать свайпы и переключать окна."
          }
        }
      }
    },
    "Required to read swipes and switch windows. If AppSwipe is already on in the list, remove it with the − button and add it again.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нужен, чтобы читать свайпы и переключать окна. Если AppSwipe в списке уже включён, удалите его кнопкой − и добавьте снова."
          }
        }
      }
    },
    "Restore Original Gestures": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вернуть исходные жесты"
          }
        }
      }
    },
    "Screen Recording": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запись экрана"
          }
        }
      }
    },
    "Settings…": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки…"
          }
        }
      }
    },
    "Show Logs in Finder": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показать логи в Finder"
          }
        }
      }
    },
    "Show apps from": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать приложения"
          }
        }
      }
    },
    "Show icon in the menu bar": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать значок в строке меню"
          }
        }
      }
    },
    "Show windows from": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывать окна"
          }
        }
      }
    },
    "Step": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаг"
          }
        }
      }
    },
    "Step length": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Длина шага"
          }
        }
      }
    },
    "Swap finger counts": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поменять местами число пальцев"
          }
        }
      }
    },
    "Swipe down for windows": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп вниз для окон"
          }
        }
      }
    },
    "Swipe here with three or four fingers": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите здесь тремя или четырьмя пальцами"
          }
        }
      }
    },
    "Swipe sideways with four fingers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп в сторону четырьмя пальцами."
          }
        }
      }
    },
    "Swipe sideways with three fingers.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп в сторону тремя пальцами."
          }
        }
      }
    },
    "Swipes do nothing until AppSwipe is resumed.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайпы ничего не делают, пока AppSwipe не возобновят."
          }
        }
      }
    },
    "Swipes do nothing while one of these apps is in front, for games and apps with their own gestures.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока одно из этих приложений на переднем плане, свайпы ничего не делают. Подходит для игр и приложений со своими жестами."
          }
        }
      }
    },
    "Swiping down with four fingers shows App Exposé.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп четырьмя пальцами вниз показывает App Exposé."
          }
        }
      }
    },
    "Swiping down with four fingers shows the windows of the app in front, instead of App Exposé.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп четырьмя пальцами вниз показывает окна приложения на переднем плане вместо App Exposé."
          }
        }
      }
    },
    "Swiping down with three fingers shows App Exposé.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп тремя пальцами вниз показывает App Exposé."
          }
        }
      }
    },
    "Swiping down with three fingers shows the windows of the app in front, instead of App Exposé.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп тремя пальцами вниз показывает окна приложения на переднем плане вместо App Exposé."
          }
        }
      }
    },
    "Swiping with four fingers switches between full-screen apps.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп четырьмя пальцами переключает полноэкранные приложения."
          }
        }
      }
    },
    "Swiping with three fingers goes back and forward between pages.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп тремя пальцами листает страницы назад и вперёд."
          }
        }
      }
    },
    "Swiping with three fingers switches between full-screen apps.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Свайп тремя пальцами переключает полноэкранные приложения."
          }
        }
      }
    },
    "Switch the moment the selection moves, without waiting for the fingers to lift.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключать, как только сдвинулось выделение, не дожидаясь, пока пальцы оторвутся."
          }
        }
      }
    },
    "Switchers": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатели"
          }
        }
      }
    },
    "Three-finger drag is on. Turn it off in Accessibility settings, or swap finger counts and turn off the three-finger Switcher.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено перетаскивание тремя пальцами. Отключите его в настройках Универсального доступа или поменяйте число пальцев местами и отключите переключатель на трёх пальцах."
          }
        }
      }
    },
    "Trackpad Gestures": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты трекпада"
          }
        }
      }
    },
    "Turn Off Conflicting Gestures": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить мешающие жесты"
          }
        }
      }
    },
    "Turn off the conflicting trackpad gestures above first, or macOS takes the swipe.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала отключите мешающие жесты трекпада выше, иначе свайп перехватит macOS."
          }
        }
      }
    },
    "Turning them off changes them for the whole Mac. Restore them here before removing AppSwipe.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключение меняет жесты для всего Mac. Верните их здесь, прежде чем удалять AppSwipe."
          }
        }
      }
    },
    "When hidden, open AppSwipe again to see these settings, and press ⌘Q here to quit it.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Если значок скрыт, откройте AppSwipe ещё раз, чтобы увидеть эти настройки, а чтобы завершить его, нажмите здесь ⌘Q."
          }
        }
      }
    },
    "Window": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Окно"
          }
        }
      }
    },
    "Window Switcher": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переключатель окон"
          }
        }
      }
    },
    "Writes every trackpad touch to a log, for bug reports. The log keeps the last 10 MB.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывает каждое касание трекпада в лог, для отчётов об ошибках. Лог хранит последние 10 МБ."
          }
        }
      }
    },
    "macOS gestures that use the same swipes take them before AppSwipe can.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Жесты macOS на тех же свайпах перехватывают их раньше AppSwipe."
          }
        }
      }
    }
  },
  "version": "1.0"
}
